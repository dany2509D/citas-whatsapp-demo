# Variables de entorno del modo "IA real" (opcional). Defínalas en el panel de su hosting
# (Netlify: Site configuration > Environment variables) o en su propia terminal.
# NUNCA escriba una clave real en este archivo ni la suba a git.

# Obligatoria para activar la IA real. Sin ella, la demo funciona en modo guion.
ANTHROPIC_API_KEY=

# Opcionales
# CLAUDE_MODEL=claude-opus-5-5        # por defecto; para menor costo y latencia: claude-haiku-5-5
# CLAUDE_FALLBACKS=off                # desactiva el respaldo de modelo ante un rechazo de seguridad
# ALLOWED_ORIGINS=https://citas-whatsapp-demo.vercel.app
